msgid "<strong>Move</strong> an item by dragging it, also into or out of a group. From the keyboard: <kbd>Alt</kbd> + arrow keys."
msgstr ""

#: includes/admin/class-acfw-guide.php:61
msgid "<strong>Add to menu</strong> (under the menu) adds an <em>endpoint</em> (a page of its own inside My Account), a <em>group</em>, a <em>link</em> or a <em>page</em>."
msgstr ""

#: includes/admin/class-acfw-guide.php:62
msgid "<strong>Click an item</strong> to edit its label, icon, badge, URL and the content shown on its page (Classic or Block editor, before, after or instead of WooCommerce’s)."
msgstr ""

#: includes/admin/class-acfw-guide.php:63
msgid "<strong>Visibility</strong> decides who sees it: roles, dates, products bought, at least / at most N orders, amount spent, days since the last order. The line under the item sums the rules up."
msgstr ""

#: includes/admin/class-acfw-guide.php:64
msgid "Each row has its <strong>on/off switch</strong>; Duplicate and Delete show on hover. Built-in items can be switched off but not deleted."
msgstr ""

#: includes/admin/class-acfw-guide.php:65
msgid "<strong>Save menu</strong> saves every item and the order at once."
